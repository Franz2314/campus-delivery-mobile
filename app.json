{
  "expo": {
    "name": "Campus Delivery",
    "slug": "campus-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "campusdelivery",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.utp.campusdelivery",
      "infoPlist": {
        "NSCameraUsageDescription": "Necesitamos la c\u00e1mara para fotografiar el comprobante de pago Yape/Plin."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "pe.utp.campusdelivery",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": {
            "scheme": "campusdelivery",
            "host": "*",
            "pathPrefix": "/"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceder a tu galer\u00eda para subir el comprobante de pago."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://campus-delivery-backend-avyi.onrender.com/api",
      "apiUrlAndroid": "https://campus-delivery-backend-avyi.onrender.com/api",
      "apiUrlPhone": "https://campus-delivery-backend-avyi.onrender.com/api",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8690c188-b6b5-46b6-b545-fc1b4ffb6d5c"
      }
    }
  }
}